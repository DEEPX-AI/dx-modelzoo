# dx-modelzoo environment configuration
# Copy this file to .env and edit values for your environment.
# CLI arguments (--model-root, --data-root) take priority over these.

DXMZ_MODEL_URL=https://sdk.deepx.ai/modelzoo

# Path to model files (onnx, dxnn, etc.)
MODEL_ROOT=download/models

# Path to datasets (ImageNet, COCO, etc.)
DATA_ROOT=download/datasets

# DX runtime device list (comma-separated)
# DXNN_DEVICES=0

# ONNX runtime async workers
# ONNX_ASYNC_WORKERS=4
